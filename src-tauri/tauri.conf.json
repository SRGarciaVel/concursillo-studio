{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Concursillo Studio",
  "version": "0.1.0",
  "identifier": "com.concursillo.studio",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:4321",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist/app"
  },
  "app": {
    "windows": [
      {
        "title": "Concursillo Studio",
        "width": 1280,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../data/questions/": "data/questions/",
      "../data/presets/": "data/presets/",
      "../data/sounds/": "data/sounds/"
    }
  }
}
